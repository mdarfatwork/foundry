# ==============================================================================
# Foundry Environment Variables Template
# ==============================================================================
# Duplicate this file as `.env.local` for local development.
# Never commit real credentials, production connection strings, or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Better Auth Configuration
# ------------------------------------------------------------------------------
# A cryptographically secure random secret (min. 32 characters).
# Generate using: `openssl rand -base64 32` or `npx @better-auth/cli secret`
BETTER_AUTH_SECRET="your-32-character-better-auth-secret-here"

# The canonical base URL for the application.
# Local development: http://localhost:3000
# Production: https://your-production-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Google OAuth V1 Credentials
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: APIs & Services > Credentials > OAuth 2.0 Client ID
#
# Authorized JavaScript Origins:
#   Local: http://localhost:3000
#   Production: https://your-production-domain.com
#
# Authorized Redirect URIs (Required path: /api/auth/callback/google):
#   Local: http://localhost:3000/api/auth/callback/google
#   Production: https://your-production-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Use the connection string provided in your Supabase Project Settings > Database.
#
# For serverless / runtime connections, use Supabase's Transaction Pooler (Port 6543 / 5432).
# Example format:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Optional: Direct PostgreSQL connection string for running migrations (Port 5432)
# DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Multi-Provider AI Configuration (NVIDIA, Google Gemini, OpenRouter)
# ------------------------------------------------------------------------------
# Active AI provider selection: "nvidia" | "google" | "openrouter" (default: nvidia)
AI_PROVIDER="nvidia"

# A. NVIDIA Hosted Inference API (https://build.nvidia.com)
NVIDIA_API_KEY="your-nvidia-api-key"
NVIDIA_MODEL="z-ai/glm-5.3-flash"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# B. Google Gemini API (https://ai.google.dev)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-api-key"
GOOGLE_MODEL="gemini-3.5-flash-lite"

# C. OpenRouter API (https://openrouter.ai)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openrouter/free"

# ------------------------------------------------------------------------------
# 5. WebContainers Browser Runtime (StackBlitz)
# ------------------------------------------------------------------------------
# Optional client API key for commercial / production WebContainer domains
NEXT_PUBLIC_WEBCONTAINER_API_KEY="your-webcontainer-api-key"



